PORT=4000

# LeadSquared (same keys as the QC app)
LSQ_API_HOST=https://api-in21.leadsquared.com/v2
LSQ_ACCESS_KEY=
LSQ_SECRET_KEY=

# Encrypts each person's own LSQ keys in the database: openssl rand -base64 32. Losing it means everyone re-enters their keys.
LSQ_KEYS_SECRET=
# Set to 1 once an LSQ admin has made BDA's "Spoke with" optional: opens Sales mode in setup.
SALES_READY=

# Supabase (the dialer's own project). SUPABASE_KEY is the service role key: backend only, never in the app.
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_KEY=
# Publishable/anon key: only used by end-to-end tests here; the app and dashboard use it to sign in.
SUPABASE_ANON_KEY=
