{
  "manifest_version": 3,
  "name": "Dialer: open leads on laptop",
  "version": "1.0.0",
  "description": "Opens a lead in LeadSquared when you tap Open on laptop in the Kalvium Dialer app.",
  "key": "",
  "permissions": ["identity", "storage", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Dialer" },
  "icons": { "128": "icon.png" }
}
